<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MixerScale.Controller.ViewModels"
        xmlns:views="clr-namespace:MixerScale.Controller.Views"
        x:Class="MixerScale.Controller.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="Дашборд"
        WindowState="FullScreen"
        WindowDecorations="None"
        Background="{StaticResource CardBgBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MixerScale.Controller/Views/Styles.axaml" />
        <ResourceInclude Source="avares://MixerScale.Controller/Views/DashboardColors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">
    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="16" Content="✕ Закрыть" 
            Click="OnCloseClick"
            Classes="CloseTab" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="24" />
    <views:DashboardView Grid.Row="1" DataContext="{Binding}" />
  </Grid>
</Window>
