<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MixerScale.Controller.Views.MainWindow"
        Title="MixerScale Controller"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620">
  <Grid RowDefinitions="Auto,*"
        Background="#F3F5F7">
    <Border Grid.Row="0"
            Background="#17202A"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="MixerScale Controller"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="EndpointText"
                   Grid.Row="1"
                   Grid.Column="0"
                   Foreground="#B8C4CE"
                   FontFamily="Consolas"
                   Margin="0,3,0,0" />
        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Border x:Name="ConnectionDot"
                  Width="14"
                  Height="14"
                  CornerRadius="7"
                  Background="#697783" />
          <TextBlock x:Name="ConnectionText"
                     Foreground="White"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Text="нет данных" />
          <Button x:Name="RefreshButton"
                  Content="Обновить"
                  Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="2*,*"
          RowDefinitions="Auto,*"
          Margin="14"
          ColumnSpacing="14"
          RowSpacing="14">
      <Border Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Background="White"
              BorderBrush="#CDD6DE"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <Grid ColumnDefinitions="*,*,*,*,*">
          <StackPanel>
            <TextBlock Text="seq"
                       Foreground="#5C6670" />
            <TextBlock x:Name="SequenceText"
                       FontFamily="Consolas"
                       FontSize="22"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="rawSum"
                       Foreground="#5C6670" />
            <TextBlock x:Name="RawSumText"
                       FontFamily="Consolas"
                       FontSize="22"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="cleanSum"
                       Foreground="#5C6670" />
            <TextBlock x:Name="CleanSumText"
                       FontFamily="Consolas"
                       FontSize="22"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="MA"
                       Foreground="#5C6670" />
            <TextBlock x:Name="PrimaryMaText"
                       FontFamily="Consolas"
                       FontSize="22"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="sample"
                       Foreground="#5C6670" />
            <TextBlock x:Name="SampleStateText"
                       FontFamily="Consolas"
                       FontSize="18"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            Grid.Column="0"
            RowDefinitions="Auto,*"
            RowSpacing="14">
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <Grid RowDefinitions="Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ContentControl x:Name="FiltersTableHost" />
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <Grid RowDefinitions="Auto,*,Auto"
                RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,90"
                  ColumnSpacing="8">
              <TextBlock Text="График"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="сек"
                         VerticalAlignment="Center"
                         Foreground="#5C6670" />
              <TextBox x:Name="GraphDurationInput"
                       Grid.Column="2"
                       Text="60"
                       FontFamily="Consolas" />
            </Grid>
            <ContentControl x:Name="GraphHost"
                            Grid.Row="1"
                            MinHeight="220" />
            <TextBlock x:Name="GraphLegendText"
                       Grid.Row="2"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="14">
        <Border Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="Wi-Fi"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="WifiText"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="UDP телеметрия"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="UdpText"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Калибровка"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsText"
                       FontFamily="Consolas"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="6">
              <TextBlock Text="sumOffset"
                         VerticalAlignment="Center"
                         Foreground="#5C6670" />
              <TextBox x:Name="SumOffsetInput"
                       Grid.Column="1"
                       FontFamily="Consolas" />
              <TextBlock Grid.Row="1"
                         Text="sumScale"
                         VerticalAlignment="Center"
                         Foreground="#5C6670" />
              <TextBox x:Name="SumScaleInput"
                       Grid.Row="1"
                       Grid.Column="1"
                       FontFamily="Consolas" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <ComboBox x:Name="ZeroSourceCombo"
                        MinWidth="150" />
              <Button x:Name="ZeroButton"
                      Grid.Column="1"
                      Content="Zero"
                      Padding="12,6" />
              <Button x:Name="SaveCalibrationButton"
                      Grid.Column="2"
                      Content="Сохранить"
                      Padding="12,6" />
            </Grid>
            <TextBlock Text="Попугаи"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <ItemsControl x:Name="UnitsList" />
            <Grid ColumnDefinitions="58,*,Auto"
                  ColumnSpacing="8">
              <TextBox x:Name="UnitNameInput"
                       MaxLength="5"
                       Watermark="ед." />
              <TextBox x:Name="UnitRawInput"
                       Grid.Column="1"
                       FontFamily="Consolas"
                       Watermark="raw/ед." />
              <Button x:Name="AddUnitButton"
                      Grid.Column="2"
                      Content="Добавить"
                      Padding="10,6" />
            </Grid>
            <TextBlock x:Name="CalibrationStatusText"
                       Foreground="#5C6670"
                       TextWrapping="Wrap" />
            <TextBlock Text="Уставки"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <ItemsControl x:Name="SetpointsList" />
            <Grid ColumnDefinitions="*,*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBox x:Name="SetpointNameInput"
                       MaxLength="24"
                       Watermark="имя" />
              <TextBox x:Name="SetpointRawInput"
                       Grid.Column="1"
                       FontFamily="Consolas"
                       Watermark="raw" />
              <Button x:Name="UseCurrentSetpointButton"
                      Grid.Column="2"
                      Content="Текущее"
                      Padding="10,6" />
              <Button x:Name="AddSetpointButton"
                      Grid.Column="3"
                      Content="Добавить"
                      Padding="10,6" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#CDD6DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="API"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ApiStatusText"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
