<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MixerScale.Controller.ViewModels"
        xmlns:views="clr-namespace:MixerScale.Controller.Views"
        x:Class="MixerScale.Controller.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MixerScale Controller"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MixerScale.Controller/Views/Styles.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- Заголовок, чтобы окно можно было таскать за шапку, 
         и чтобы табы не наезжали на кнопки управления окном -->
    <Border Grid.Row="0" Height="30" IsHitTestVisible="False" Background="Transparent" />

    <!-- Вкладки (бетономешалки + настройки) -->
    <TabControl Grid.Row="1"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab}">
      <TabControl.DataTemplates>
        <!-- Вкладка бетономешалки -->
        <DataTemplate DataType="vm:MixerViewModel">
          <views:MixerView />
        </DataTemplate>
        <!-- Вкладка настроек -->
        <DataTemplate DataType="vm:SettingsViewModel">
          <StackPanel Margin="32" Spacing="16">
            <TextBlock Text="Настройки приложения" FontSize="24" FontWeight="SemiBold" />
            
            <TextBlock Text="Добавление новых подключений:" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="＋ Реальные весы"
                      Click="OnAddRealClick"
                      Padding="{StaticResource ButtonLargePadding}" />
              <Button Content="＋ Эмулятор весов"
                      Command="{Binding Main.AddEmulatorCommand}"
                      Padding="{StaticResource ButtonLargePadding}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </TabControl.DataTemplates>

      <TabControl.ItemTemplate>
        <DataTemplate x:CompileBindings="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
            <Button Content="✕"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveMixerCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Classes="CloseTab"
                    ToolTip.Tip="Удалить"
                    Width="24" Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </Grid>
</Window>
