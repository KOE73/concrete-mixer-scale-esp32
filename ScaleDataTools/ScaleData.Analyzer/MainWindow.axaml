<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ava="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="ScaleData.Analyzer.MainWindow"
        Title="Scale Data Analyzer"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="640">
  <Grid x:Name="RootGrid"
        RowDefinitions="*"
        ColumnDefinitions="360,*">
    <Border Grid.Row="0"
            Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="LightGray">
      <Grid RowDefinitions="Auto,*"
            Margin="8">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,6">
          <TextBlock Text="Весы / CSV-файлы"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
          <Button x:Name="CollapseFilesButton"
                  Grid.Column="1"
                  Content="&lt;"
                  Width="28"
                  Height="26"
                  Padding="0" />
        </Grid>

        <Grid x:Name="FilesPanel"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock x:Name="FolderText"
                     Grid.Row="0"
                     TextWrapping="Wrap"
                     Margin="0,0,0,3" />
          <TextBlock x:Name="StatusText"
                     Grid.Row="1"
                     FontSize="11"
                     Foreground="Gray"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,0,4" />
          <ListBox x:Name="ScaleFoldersList"
                   Grid.Row="2"
                   FontFamily="Consolas"
                   FontSize="12"
                   MaxHeight="110"
                   Margin="0,0,0,6" />
          <ListBox x:Name="FilesList"
                   Grid.Row="3"
                   FontFamily="Consolas"
                   FontSize="12" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="0"
          Grid.Column="1"
          RowDefinitions="*,Auto">
      <ava:AvaPlot x:Name="Plot"
                   Grid.Row="0" />

      <Grid Grid.Row="1"
            ColumnDefinitions="Auto,320,*,Auto"
            Margin="0,4,12,8">


        <Border Grid.Column="0"
                Margin="5,0,5,0"
                Padding="6,4"
                BorderBrush="#666"
                BorderThickness="1"
                CornerRadius="6"
                Background="#F5F5F5">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="5">
                <StackPanel Orientation="Vertical"
                            Spacing="2"
                            Margin="0,0,0,2">
                    <Button x:Name="ResetZoomButton"
                            Content="Сбросить зум"
                            Padding="6,2"
                            Margin="0,0,8,2" />
                    <CheckBox x:Name="AutoScaleOnNewDataCheckBox"
                              Content="Автозум"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                </StackPanel>

                <StackPanel Orientation="Vertical"
                            Spacing="2"
                            Margin="0,0,0,2">
                    <CheckBox x:Name="AutoReloadCheckBox"
                              Content="Автоподгрузка"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Padding="6,2" />
                    <CheckBox x:Name="FollowNewDataCheckBox"
                              Content="Слежение"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Padding="6,2" />
                </StackPanel>

                <StackPanel Orientation="Vertical"
                            Spacing="2"
                            Margin="0,0,0,2">
                    <CheckBox x:Name="ShowMaCheckBox"
                              Content="MA"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowRawCheckBox"
                              Content="RAW"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowTotalCheckBox"
                              Content="Всего"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowSensorsCheckBox"
                              Content="Датчики"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Margin="0,0,10,0"
                Padding="8,6"
                BorderBrush="#666"
                BorderThickness="1"
                CornerRadius="6"
                Background="#F5F5F5">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Сводка"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText"
                           Grid.Row="1"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Margin="0,0,10,0"
                Padding="8,6"
                BorderBrush="#666"
                BorderThickness="1"
                CornerRadius="6"
                Background="#F5F5F5">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Потери seq"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="LossText"
                           Grid.Row="1"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Column="3"
                Margin="0,0,0,0"
                Padding="8,6"
                BorderBrush="#666"
                BorderThickness="1"
                CornerRadius="6"
                Background="#F5F5F5">
            <StackPanel Orientation="Vertical"
                        Spacing="4"
                        MinWidth="150">
                <TextBlock Text="Датчики"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <Button x:Name="ZeroSensorsButton"
                        Content="Обнулить"
                        Padding="8,4"
                        HorizontalAlignment="Stretch" />
                <TextBlock x:Name="ZeroSensorsStatusText"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
